# Copy to `.env` next to docker-compose.yaml and fill in.

# Public address. PENFORGE_SITE is the host name Caddy serves; the public URI
# is what users open (add the port when it is not 443).
PENFORGE_SITE=penforge.example.com
PENFORGE_PUBLIC_URI=https://penforge.example.com
PENFORGE_HTTP_PORT=80
PENFORGE_HTTPS_PORT=443
# "internal" (Caddy's own CA, browsers warn) or your email for Let's Encrypt
PENFORGE_TLS=admin@example.com

# Secrets: generate each with `openssl rand -base64 32`
PENPOT_SECRET_KEY=
PENFORGE_SECRET_KEY=
POSTGRES_PASSWORD=

# Penpot accounts (emails, comma separated) that may open
# <public URI>/penforge/admin/ to set the Anthropic API key and limits
PENFORGE_ADMIN_EMAILS=admin@example.com

# Images. Penforge builds (README "Build the images") carry the AI panels; the
# upstream penpotapp/* images run Penpot without them.
PENFORGE_FRONTEND_IMAGE=penpotapp/frontend:penforge
PENFORGE_BACKEND_IMAGE=penpotapp/backend:penforge
PENFORGE_EXPORTER_IMAGE=penpotapp/exporter:penforge
PENFORGE_AGENT_IMAGE=penforge/agent:local

# api-key (default) or fake (replies without calling Anthropic; for tests)
PENFORGE_RUNNER=api-key
